# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/flfgpools/flfg-new"
PassengerBaseURI "/"
PassengerNodejs "/home/flfgpools/nodevenv/flfg-new/20/bin/node"
PassengerAppType node
PassengerStartupFile app.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
RewriteEngine On
RewriteOptions inherit

# =========================================================
# REDIRECCIÓN DE LA RAÍZ A /en
# =========================================================

RewriteRule ^$ /en [R=302,L]

# =========================================================
# REDIRECCIONES ANTIGUAS
# =========================================================

RewriteCond %{HTTP_HOST} ^flfgpools\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.flfgpools\.com$
RewriteRule ^home$ https://flfgpools.com/en [R=301,L]

RewriteCond %{HTTP_HOST} ^.*$
RewriteRule ^en/home$ https://flfgpools.com/en [R=301,L]

RewriteCond %{HTTP_HOST} ^flfgpools\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.flfgpools\.com$
RewriteRule ^pools$ https://flfgpools.com/en/products [R=301,L]

RewriteCond %{HTTP_HOST} ^flfgpools\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.flfgpools\.com$
RewriteRule ^resources$ https://flfgpools.com/en/info/faqs [R=301,L]

RewriteCond %{HTTP_HOST} ^.*$
RewriteRule ^en/resources$ https://flfgpools.com/en/info/faqs [R=301,L]

RewriteCond %{HTTP_HOST} ^.*$
RewriteRule ^en/projects$ https://flfgpools.com/en/showroom [R=301,L]

RewriteCond %{HTTP_HOST} ^flfgpools\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.flfgpools\.com$
RewriteRule ^our-projects$ https://flfgpools.com/en/showroom [R=301,L]

RewriteCond %{HTTP_HOST} ^flfgpools\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.flfgpools\.com$
RewriteRule ^service$ https://flfgpools.com/en/products [R=301,L]

RewriteCond %{HTTP_HOST} ^.*$
RewriteRule ^categoria-produto$ https://flfgpools.com/en/products [R=301,L]

RewriteCond %{HTTP_HOST} ^.*$
RewriteRule ^produto$ https://flfgpools.com/en/products [R=301,L]

# =========================================================
# CLOUDLINUX PASSENGER - NEXT.JS / NODE.JS
# =========================================================

# =========================================================
# VARIABLES DE ENTORNO
# =========================================================

# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
SetEnv LEADS_TO_EMAIL sales@flfgpools.com
SetEnv SMTP_FROM Florida Fiberglass Pools <floridafiberglasspools@gmail.com>
SetEnv SMTP_HOST smtp.gmail.com
SetEnv SMTP_PORT 587
SetEnv SMTP_USER floridafiberglasspools@gmail.com
SetEnv SMTP_PASS iuhcliimgcxnwijw
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END

# =========================================================
# SEGURIDAD
# =========================================================

Options -Indexes

<Files ".user.ini">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
